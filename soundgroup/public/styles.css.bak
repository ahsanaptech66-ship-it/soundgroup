x 8px;border-radius:99px}.status-badge i{width:5px;height:5px;border-radius:50%;background:var(--good)}.empty-state{grid-column:1/-1;min-height:220px;border:1px dashed var(--line);border-radius:18px;display:grid;place-items:center;text-align:center;padding:30px}.empty-state h3{font:700 21px Manrope;margin:6px 0}.empty-state p{color:#7d838e;max-width:500px;font-size:11px}.empty-state .empty-icon{font-size:30px;color:var(--accent2)}.card-menu{position:absolute;z-index:8;right:7px;top:43px;display:none;width:160px;background:#11131b;border:1px solid var(--line);border-radius:11px;box-shadow:0 20px 50px rgba(0,0,0,.5);padding:5px}.card-menu.open{display:block}.card-menu button{display:block;width:100%;text-align:left;padding:8px;border-radius:7px;background:transparent;font-size:10px}.card-menu button:hover{background:var(--surface)}@media(max-width:1100px){:root{--sidebar:210px}.hero{grid-template-columns:1fr}.hero-stage{height:340px}.experience-grid{grid-template-columns:1fr 1fr}.experience-card:last-child{grid-column:1/-1}.format-grid{grid-template-columns:repeat(2,1fr)}.mood-grid{grid-template-columns:repeat(3,1fr)}.player{grid-template-columns:230px minmax(220px,1fr) 210px}.settings-grid{grid-template-columns:1fr}.account-layout{grid-template-columns:1fr}.import-shell{grid-template-columns:1fr}.import-aside{position:static}.video-controls{grid-template-columns:auto auto auto auto minmax(80px,1fr) auto auto auto auto auto}.video-controls .ctrl{font-size:10px}}@media(max-width:760px){:root{--sidebar:0px;--player:72px}.app-shell{display:block}.sidebar{transform:translateX(-105%);width:min(300px,88vw);transition:.25s var(--ease);box-shadow:20px 0 70px rgba(0,0,0,.5)}.sidebar.open{transform:none}.mobile-close{display:grid}.main{padding-bottom:calc(var(--player) + 20px)}.topbar{padding:0 12px;height:62px}.mobile-menu{display:grid;flex:none}.top-actions .icon-btn:first-child{display:none}.search-wrap{min-width:0}.search-shortcut{display:none}.views{padding:0 14px}.view{padding:20px 0 45px}.hero{padding:22px 0;min-height:auto}.hero h1{font-size:45px}.hero p{font-size:13px}.hero-stage{height:280px;transform:scale(.82);margin:-15px 0}.hero-badge{right:-1%;bottom:0}.section{margin-top:32px}.section-head h2{font-size:20px}.experience-grid{grid-template-columns:1fr}.experience-card:last-child{grid-column:auto}.format-grid{grid-template-columns:1fr 1fr}.page-heading{align-items:start;flex-direction:column;margin-bottom:20px}.page-heading h1{font-size:42px}.music-spotlight,.discover-hero{align-items:start;flex-direction:column}.music-stat{text-align:left}.discover-art{width:100%;height:160px}.watch-hero{grid-template-columns:1fr}.watch-hero-art{min-height:230px}.watch-hero-copy{padding:25px}.video-grid{grid-template-columns:1fr 1fr;gap:16px 9px}.explore-grid{grid-template-columns:repeat(2,1fr);gap:14px 9px}.artist-grid{grid-template-columns:repeat(2,1fr)}.player{left:8px;right:8px;bottom:8px;height:62px;grid-template-columns:minmax(0,1fr) auto;gap:6px;padding:6px 8px}.player-center{position:absolute;left:55px;right:105px;bottom:4px}.player-track{padding-right:70px}.player-tools{gap:2px}.player-tools .ctrl:first-child{display:none}.vol-bar{display:none}.heart-player{margin-left:4px}.track-meta{max-width:180px}.track-tech{display:none}.timeline{margin-top:2px}.controls{justify-content:flex-start;position:absolute;right:0;bottom:8px}.controls .ctrl:first-child,.controls .ctrl:last-child{display:none}.play-main{width:32px;height:32px}.video-player-modal,.full-player,.auth-modal,#playlist-modal,#edit-media-modal{padding:10px}.video-player-card{border-radius:16px}.video-controls{padding:30px 7px 8px;gap:2px;grid-template-columns:auto auto auto minmax(50px,1fr) auto auto auto}.video-controls #vquality,.video-controls #vpip,.video-controls #vspeed{display:none}.video-meta{flex-direction:column;padding:14px}.video-actions{flex-wrap:wrap}.full-player-grid{grid-template-columns:1fr;gap:25px}.full-art-wrap{width:min(330px,70vw);margin:auto}.full-copy{text-align:center}.full-actions{justify-content:center}.auth-card{grid-template-columns:1fr}.auth-art{min-height:180px}.auth-panel{padding:24px}.theme-selector{grid-template-columns:repeat(4,1fr)}.progress-style-grid{grid-template-columns:repeat(3,1fr)}.range-row{grid-template-columns:1fr}.stats-row{grid-template-columns:1fr 1fr}.studio-grid{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.full-field{grid-column:auto}.import-shell{gap:10px}.drop-zone{min-height:300px;padding:24px}.toast{right:10px;bottom:80px}.hero-actions .btn{flex:1}.sidebar-bottom{padding-bottom:8px}}@media(max-width:430px){.video-grid,.explore-grid{grid-template-columns:1fr 1fr}.format-grid{grid-template-columns:1fr 1fr}.mood-grid{grid-template-columns:1fr 1fr}.hero-stage{transform:scale(.72);margin:-35px 0}.hero h1{font-size:40px}.hero-actions{flex-direction:column}.hero-actions .btn{width:100%}.player-track{padding-right:54px}.track-meta{max-width:145px}.top-actions .notification{display:none}}

/* ========================= PHASE VI — LIQUID GLASS 2.0 ========================= */
:root{
  --glass-blur:24px;
  --glass-opacity:.68;
  --motion-micro:140ms;
  --motion-ui:240ms;
  --motion-surface:380ms;
  --motion-cinematic:680ms;
  --player-glow:0 20px 90px color-mix(in srgb,var(--accent) 16%,transparent),0 30px 90px rgba(0,0,0,.55);
}

/* richer surfaces without turning the entire app into glass */
.sidebar,.player,.queue-panel,.notification-panel,.command-box,.modal-card,.auth-card,.video-player-card,.setting-card,.profile-card,.studio-card,.experience-card,.discover-hero,.music-spotlight,.watch-hero,.drop-zone{
  background:linear-gradient(135deg,rgba(255,255,255,.065),rgba(255,255,255,.018)),rgba(10,12,19,var(--glass-opacity));
  backdrop-filter:blur(var(--glass-blur)) saturate(145%);
  -webkit-backdrop-filter:blur(var(--glass-blur)) saturate(145%);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.08),inset 0 -1px 0 rgba(255,255,255,.025),0 24px 80px rgba(0,0,0,.25);
}
.sidebar::after,.player::after,.setting-card::after,.video-player-card::after,.modal-card::after,.auth-card::after{
  content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;background:linear-gradient(115deg,rgba(255,255,255,.09),transparent 28%,transparent 72%,rgba(255,255,255,.035));opacity:.65;mix-blend-mode:screen;
}
.player{isolation:isolate;box-shadow:var(--player-glow);transition:transform var(--motion-surface) var(--ease),box-shadow var(--motion-surface) var(--ease),border-color var(--motion-ui) var(--ease);}
.player:hover{transform:translateY(-3px);box-shadow:0 28px 110px color-mix(in srgb,var(--accent) 20%,transparent),0 30px 100px rgba(0,0,0,.58);border-color:color-mix(in srgb,var(--accent) 35%,rgba(255,255,255,.12));}
.player.has-track .cover-wrap{animation:coverBreath 4s ease-in-out infinite;box-shadow:0 10px 40px color-mix(in srgb,var(--accent) 28%,transparent)}
@keyframes coverBreath{0%,100%{transform:scale(1)}50%{transform:scale(1.025)}}

/* cards regain physicality */
.media-card,.artist-card,.playlist-card,.experience-card{transition:transform var(--motion-ui) var(--ease),filter var(--motion-ui) var(--ease);}
.media-card:hover,.artist-card:hover,.playlist-card:hover{transform:translateY(-5px)}
.media-card:hover .thumb{transform:translateY(-2px) scale(1.012);box-shadow:0 18px 55px rgba(0,0,0,.35),0 0 45px color-mix(in srgb,var(--accent) 10%,transparent)}
.thumb{transition:transform var(--motion-ui) var(--ease),border-color var(--motion-ui) var(--ease),box-shadow var(--motion-ui) var(--ease)}
.thumb:after{content:"";position:absolute;inset:-20% -40%;background:linear-gradient(105deg,transparent 35%,rgba(255,255,255,.16) 50%,transparent 65%);transform:translateX(-70%) rotate(8deg);opacity:0;transition:transform .8s var(--ease),opacity .3s ease;pointer-events:none}
.media-card:hover .thumb:after{transform:translateX(70%) rotate(8deg);opacity:.7}

/* tactile controls */
.ctrl,.icon-btn,.play-main,.btn,.progress-style,.switch span,.account-links button{transition:transform var(--motion-micro) var(--ease),background var(--motion-ui) var(--ease),border-color var(--motion-ui) var(--ease),box-shadow var(--motion-ui) var(--ease),color var(--motion-ui) var(--ease)}
.ctrl:hover,.icon-btn:hover,.progress-style:hover{transform:translateY(-2px) scale(1.035);background:rgba(255,255,255,.08);box-shadow:0 8px 28px color-mix(in srgb,var(--accent) 12%,transparent)}
.ctrl:active,.icon-btn:active,.play-main:active,.btn:active,.progress-style:active{transform:translateY(1px) scale(.96)}

/* premium timeline system */
.track-bar{position:relative;overflow:visible!important;height:7px!important;border-radius:999px;background:rgba(255,255,255,.09)!important;cursor:pointer;--progress:0%;}
.track-bar::before{content:"";position:absolute;inset:-6px 0;pointer-events:none;border-radius:inherit;}
#track-fill,#full-track-fill{position:absolute!important;left:0!important;top:0!important;bottom:0!important;width:var(--progress,0%)!important;border-radius:inherit;background:linear-gradient(90deg,var(--accent),var(--accent2))!important;box-shadow:0 0 18px color-mix(in srgb,var(--accent) 38%,transparent);transition:width 80ms linear;}
#track-knob,#full-track-knob{position:absolute!important;left:var(--progress,0%)!important;top:50%!important;width:13px!important;height:13px!important;border-radius:50%!important;background:#fff!important;transform:translate(-50%,-50%) scale(.72)!important;box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 22%,transparent),0 4px 18px rgba(0,0,0,.5)!important;transition:transform var(--motion-micro) var(--ease),box-shadow var(--motion-micro) var(--ease);z-index:4;}
.track-bar:hover #track-knob,.track-bar:hover #full-track-knob{transform:translate(-50%,-50%) scale(1)!important;box-shadow:0 0 0 6px color-mix(in srgb,var(--accent) 20%,transparent),0 0 24px var(--accent)!important;}

.track-bar[data-progress-style="Classic"] #track-fill,
.track-bar[data-progress-style="Classic"] #full-track-fill {
  background: linear-gradient(90deg, var(--accent2), var(--accent)) !important;
}

.track-bar[data-progress-style="Minimal"] #track-fill,
.track-bar[data-progress-style="Minimal"] #full-track-fill {
  box-shadow: none;
  background: var(--text) !important;
  height: 3px !important;
  top: 2px;
}
.track-bar[data-progress-style="Minimal"] #track-fill::after,
.track-bar[data-progress-style="Minimal"] #full-track-fill::after {
  display: none;
}

.track-bar[data-progress-style="Glow"] #track-fill,
.track-bar[data-progress-style="Glow"] #full-track-fill {
  background: #fff !important;
  box-shadow: 0 0 10px var(--accent), 0 0 24px var(--accent2), 0 0 40px var(--accent) !important;
}

.track-bar[data-progress-style="Pulse"] #track-fill,
.track-bar[data-progress-style="Pulse"] #full-track-fill {
  background: linear-gradient(90deg, var(--accent2), var(--accent)) !important;
  animation: pulseLine var(--timeline-duration) ease-in-out infinite;
}
@keyframes pulseLine {
  50% { filter: brightness(1.4); box-shadow: 0 0 20px var(--accent); }
}
.track-bar.is-playing[data-progress-style="Pulse"] #track-fill,
.track-bar.is-playing[data-progress-style="Pulse"] #full-track-fill {
  animation-play-state: running;
}

.track-bar[data-progress-style="Wave"] #track-fill,
.track-bar[data-progress-style="Wave"] #full-track-fill {
  height: 10px;
  top: -1px;
  background: repeating-radial-gradient(circle at 50% 50%, var(--accent) 0 2px, transparent 3px 6px) !important;
  animation: waveFlow 1s linear infinite;
  animation-play-state: paused;
}
@keyframes waveFlow {
  to { background-position: 12px 0; }
}
.track-bar.is-playing[data-progress-style="Wave"] #track-fill,
.track-bar.is-playing[data-progress-style="Wave"] #full-track-fill {
  animation-play-state: running;
}

.full-timeline {
  display: grid;
  grid-template-columns: 42px minmax(180px, 1fr) 42px;
  align-items: center;
  gap: 10px;
  margin: 18px 0 10px;
  color: #8f96a3;
  font-size: 10px;
}
.full-track-bar {
  height: 8px !important;
}

.style-preview {
  height: 7px;
  border-radius: 99px;
  display: block;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
  position: relative;
  overflow: visible;
  box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 25%, transparent);
}

.style-minimal {
  box-shadow: none;
  background: var(--text);
  height: 3px;
}

.style-glow {
  background: #fff;
  box-shadow: 0 0 10px var(--accent), 0 0 24px var(--accent2), 0 0 40px var(--accent);
}

.style-pulse {
  animation: pulseLine 1.1s ease-in-out infinite;
}

.style-wave {
  height: 11px;
  background: repeating-radial-gradient(ellipse at 50% 100%, var(--accent) 0 2px, transparent 3px 7px);
  animation: waveFlow .9s linear infinite;
}

@media(prefers-reduced-motion: reduce) {
  #track-fill::after, #full-track-fill::after, .style-pulse, .style-wave { animation: none !important; }
}
/* PHASE 7-10 — metadata, public information and review/rating surfaces */
.site-info-grid{display:grid;grid-template-columns:1.4fr .8fr;gap:12px}.site-info-grid .setting-card{margin:0}.site-info-grid h3{font:700 22px/1.2 Manrope;margin:0}.site-info-grid p{color:var(--muted);font-size:12px;line-height:1.6}.catalog-filters{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.catalog-filters select{min-height:34px;padding:0 10px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.035);color:var(--text);font-size:10px}.rating-stars{display:flex;gap:4px;align-items:center}.rating-stars button{border:0;background:transparent;color:#707785;font-size:20px;cursor:pointer;padding:2px}.rating-stars button.active{color:#ffd76b}.review-item{padding:10px 0;border-bottom:1px solid var(--line)}.review-item:last-child{border-bottom:0}.review-meta{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:10px}.review-item p{margin:6px 0 0;font-size:12px;line-height:1.5}.review-compose{display:grid;gap:8px;margin-top:14px}.review-compose textarea{min-height:90px}.detail-meta-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:14px 0}.detail-meta-grid div{padding:9px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.025)}.detail-meta-grid small,.detail-meta-grid strong{display:block}.detail-meta-grid small{color:var(--muted);font-size:9px}.detail-meta-grid strong{margin-top:3px;font-size:11px}.detail-rating{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 0;border-top:1px solid var(--line)}@media(max-width:760px){.site-info-grid{grid-template-columns:1fr}.detail-meta-grid{grid-template-columns:1fr 1fr}}

.new-badge{position:absolute;left:8px;top:8px;z-index:3;padding:4px 7px;border-radius:999px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#090a0f;font-size:8px;font-weight:900;letter-spacing:.08em;box-shadow:0 6px 18px rgba(98,215,255,.18);animation:newBadgePulse 2.5s ease-in-out infinite}@keyframes newBadgePulse{0%,100%{transform:scale(1);opacity:.82}50%{transform:scale(1.04);opacity:1}}@media(prefers-reduced-motion:reduce){.new-badge{animation:none}}

/* Phase 7-10 registration fields */
.auth-panel #auth-register { display:grid; gap:10px; }
.auth-panel #auth-register.hidden { display:none; }
.auth-panel #auth-register label { display:grid; gap:6px; }


/* Phase 9.1 — review/modal interaction and placement fixes */
.overlay-modal .modal-card{max-height:calc(100vh - 56px);overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.16) transparent;}
.overlay-modal .modal-card::-webkit-scrollbar{width:7px}.overlay-modal .modal-card::-webkit-scrollbar-thumb{background:rgba(255,255,255,.14);border-radius:99px}.overlay-modal .modal-card::-webkit-scrollbar-track{background:transparent}
.media-card .card-menu{max-height:min(300px,calc(100vh - 120px));overflow:auto}
.detail-community{display:flex;flex-direction:column;gap:16px}.detail-rating{flex:none}.detail-community .review-section{margin-top:0;padding-top:0}.review-section #media-review-list{max-height:min(34vh,330px);overflow:auto;padding-right:6px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.14) transparent}.review-section #media-review-list::-webkit-scrollbar{width:6px}.review-section #media-review-list::-webkit-scrollbar-thumb{background:rgba(255,255,255,.13);border-radius:99px}.review-section #media-review-list::-webkit-scrollbar-track{background:transparent}.review-compose{margin-top:0;padding-top:14px;border-top:1px solid var(--line)}
@media(max-width:760px){.overlay-modal{padding:14px}.overlay-modal .modal-card{max-height:calc(100vh - 28px);padding:18px}.review-section #media-review-list{max-height:32vh}.detail-community{gap:12px}}

/* Phase 9 — public reviews and ratings */
.detail-community{margin-top:18px;padding-top:14px;border-top:1px solid var(--line)}
.detail-community-private{padding:12px 0 4px;color:var(--muted)}
.detail-community-private p{margin:.35rem 0 0;font-size:12px;line-height:1.55}
.detail-your-rating{display:block;margin-bottom:3px;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.12em}
.detail-rating{gap:20px;align-items:flex-end}
.detail-rating>div:first-child{min-width:0}
.detail-rating>div:first-child #media-rating-summary{margin-top:3px;font-size:16px;font-weight:700}
.review-compose{gap:10px}
.review-compose-actions{display:flex;align-items:center;justify-content:space-between;gap:12px}
.review-compose textarea:disabled{opacity:.65;cursor:not-allowed}
.review-compose .btn:disabled{opacity:.5;cursor:not-allowed}
.review-count{color:var(--muted);font-size:10px}
.review-section{margin-top:18px;padding-top:2px}
.review-section .section-head{margin-bottom:8px}
.review-item{padding:12px 0;border-bottom:1px solid var(--line)}
.review-item:last-child{border-bottom:0}
.review-item p{white-space:pre-wrap;overflow-wrap:anywhere}
.review-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:7px}
.rating-stars button{transition:transform .16s var(--ease),color .16s var(--ease),opacity .16s var(--ease)}
.rating-stars button:hover{transform:translateY(-1px) scale(1.04);color:#ffe58c}
.rating-stars button:focus-visible{outline:2px solid var(--accent2);outline-offset:2px;border-radius:6px}
.rating-stars button:not(.active){opacity:.7}
@media(max-width:760px){
  .detail-rating{align-items:flex-start;flex-direction:column;gap:10px}
  .review-compose-actions{align-items:flex-start;flex-direction:column}
  .review-compose-actions .btn{width:100%}
}

/* Phase 7-10.15 — stable media details popup behavior */
body.modal-open{overflow:hidden}
#media-detail-modal{position:fixed;inset:0;z-index:90;display:none;place-items:center;padding:18px;background:rgba(3,4,8,.76)}
#media-detail-modal.open{display:grid}
#media-detail-modal .modal-card{width:min(720px,94vw);max-height:calc(100vh - 36px);overflow:auto;overscroll-behavior:contain}
@media(max-width:760px){#media-detail-modal{padding:12px}#media-detail-modal .modal-card{width:min(720px,96vw);max-height:calc(100vh - 24px);padding:18px}.detail-meta-grid{grid-template-columns:1fr 1fr}.detail-community{gap:12px}}

/* Phase 7-10.17 — review popup polish + stable rating interaction */
#media-detail-modal .modal-card{
  width:min(680px,calc(100vw - 32px));
  max-width:680px;
  min-width:0;
  overflow-x:hidden;
  overflow-y:auto;
  padding:24px;
  scrollbar-gutter:stable;
}
#media-detail-content,
#media-detail-content *{min-width:0;max-width:100%;}
#media-detail-content .detail-title{
  margin:8px 48px 6px 0;
  font:700 clamp(22px,4vw,32px)/1.12 Manrope,Inter,ui-sans-serif,system-ui,sans-serif;
  letter-spacing:-.045em;
  overflow-wrap:anywhere;
  word-break:break-word;
  white-space:normal;
}
#media-detail-content .detail-subline{
  margin:0 0 2px;
  color:var(--muted);
  font-size:12px;
  overflow-wrap:anywhere;
}
#media-detail-content .detail-meta-grid{margin-top:16px;}
#media-rating-stars[aria-busy="true"]{opacity:.8;}
#media-rating-stars button:disabled{cursor:wait;transform:none!important;}
#media-rating-stars button.active{filter:drop-shadow(0 0 8px rgba(255,215,107,.16));}
@media(max-width:760px){
  #media-detail-modal{padding:10px;}
  #media-detail-modal .modal-card{
    width:min(100%,calc(100vw - 20px));
    max-height:calc(100vh - 20px);
    padding:18px;
    border-radius:18px;
  }
  #media-detail-content .detail-title{font-size:clamp(21px,7vw,28px);margin-right:40px;}
}

/* Reviews / Ratings Phase 2 — compact discovery summaries and richer review controls */
.media-rating-mini{display:inline-flex;align-items:center;gap:5px;margin-top:3px;color:#d7dbe4;font-size:10px;line-height:1.2;font-weight:700;letter-spacing:.01em;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rating-overview{display:flex;align-items:baseline;gap:8px;margin-top:4px}.rating-overview strong{font-size:25px;line-height:1;font-weight:800;letter-spacing:-.03em}.rating-overview span{color:var(--muted);font-size:10px}.rating-distribution{display:grid;gap:4px;margin-top:9px;min-width:min(270px,100%)}.rating-dist-row{display:grid;grid-template-columns:24px minmax(80px,1fr) 22px;gap:7px;align-items:center;font-size:9px;color:var(--muted)}.rating-dist-track{display:block;height:5px;border-radius:999px;background:rgba(255,255,255,.07);overflow:hidden}.rating-dist-track i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#ffd76b,#ffb66e);min-width:0}.rating-dist-row small{text-align:right;font-size:9px;color:var(--muted)}.review-toolbar{display:flex;align-items:center;gap:8px}.review-toolbar select{min-height:30px;padding:0 9px;border:1px solid var(--line);border-radius:9px;background:rgba(255,255,255,.035);color:var(--text);font-size:10px}.review-load-more{display:block;margin:10px auto 0}.review-load-more[hidden]{display:none!important}.review-helpful-btn[aria-pressed="true"]{color:#ffd76b}.review-helpful-btn{margin-left:8px}
@media(max-width:760px){.media-rating-mini{font-size:9px}.review-toolbar{align-items:flex-end;flex-direction:column;gap:6px}.review-toolbar select{width:100%}.rating-overview strong{font-size:22px}.rating-distribution{min-width:0}}
/* AUTH MODAL — register/login overflow + responsive stability */
#auth-modal{
  overflow:hidden;
  padding:16px;
}
#auth-modal .auth-card{
  width:min(800px,calc(100vw - 32px));
  max-width:800px;
  height:min(820px,calc(100dvh - 32px));
  max-height:calc(100dvh - 32px);
  min-height:0;
  display:grid;
  grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);
  overflow:hidden;
}
#auth-modal .auth-art{
  min-height:0;
  height:auto;
  align-self:stretch;
}
#auth-modal .auth-panel{
  min-width:0;
  min-height:0;
  height:100%;
  overflow-y:auto;
  overflow-x:hidden;
  overscroll-behavior:contain;
  scrollbar-width:thin;
  scrollbar-color:rgba(255,255,255,.16) transparent;
}
#auth-modal .auth-panel::-webkit-scrollbar{width:7px}
#auth-modal .auth-panel::-webkit-scrollbar-thumb{background:rgba(255,255,255,.14);border-radius:99px}
#auth-modal .auth-panel::-webkit-scrollbar-track{background:transparent}
#auth-modal #auth-register{min-width:0;padding-bottom:6px}
#auth-modal #auth-register .btn.full{margin-top:2px;margin-bottom:4px}
#auth-modal #auth-register .terms{margin-top:10px;margin-bottom:8px}

@media(max-width:760px){
  #auth-modal{padding:10px;place-items:center}
  #auth-modal .auth-card{
    width:min(440px,calc(100vw - 20px));
    max-width:440px;
    height:min(760px,calc(100dvh - 20px));
    max-height:calc(100dvh - 20px);
    grid-template-columns:1fr;
    grid-template-rows:auto minmax(0,1fr);
    border-radius:20px;
  }
  #auth-modal .auth-art{
    min-height:145px;
    padding:22px;
    justify-content:end;
  }
  #auth-modal .auth-art strong{font-size:24px;line-height:1.05}
  #auth-modal .auth-panel{padding:20px;min-height:0;overflow-y:auto}
  #auth-modal .auth-tabs{margin-bottom:20px}
  #auth-modal .auth-panel h2{font-size:24px;margin-bottom:14px}
  #auth-modal .auth-panel label{margin:10px 0}
#auth-modal .auth-panel input{padding:11px; font-size: 16px;}
}

@media(max-width:430px){
  #auth-modal{padding:8px}
  #auth-modal .auth-card{width:calc(100vw - 16px);max-height:calc(100dvh - 16px);border-radius:18px}
  #auth-modal .auth-art{min-height:128px;padding:18px}
  #auth-modal .auth-art strong{font-size:21px}
  #auth-modal .auth-panel{padding:18px}
  #auth-modal .auth-tabs button{padding:9px 7px}
  #auth-modal .auth-panel h2{font-size:22px}
  #auth-modal #auth-register .terms{font-size:9px}
}

