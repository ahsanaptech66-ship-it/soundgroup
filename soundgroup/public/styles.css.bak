:root{--bg:#07080d;--panel:#0e1018;--panel2:#131622;--surface:rgba(255,255,255,.055);--surface2:rgba(255,255,255,.085);--line:rgba(255,255,255,.10);--text:#f5f6fa;--muted:#989daa;--accent:#9b8cff;--accent2:#62d7ff;--good:#62e0a7;--danger:#ff6d84;--sidebar:238px;--top:70px;--player:84px;--radius:22px;--ease:cubic-bezier(.2,.8,.2,1)}

:root {
  --text: #fff;
  --muted: #aeb2bc;
  --surface: rgba(255,255,255,0.055);
  --line: rgba(255,255,255,0.08);
}

html[data-theme="Light"] {
  --text: #1a1b26;
  --muted: #6b7280;
  --surface: rgba(0,0,0,0.06);
  --line: rgba(0,0,0,0.12);
}
html[data-theme="Light"] .app-shell { background: var(--bg); color: var(--text); }
html[data-theme="Light"] input, html[data-theme="Light"] select, html[data-theme="Light"] button { color: var(--text); }
html[data-theme="Light"] .setting-card, html[data-theme="Light"] .sidebar { background: #ffffff; border-color: var(--line); }
html[data-theme="Light"] .hero h1 { color: #000; }
html[data-theme="Light"] .media-card { background: #ffffff; }
html[data-theme="Light"] .track-bar[data-progress-style="Minimal"] #track-fill,
html[data-theme="Light"] .style-minimal { background: #1a1b26 !important; }

html[data-theme="Void"] {
  --surface: rgba(255,255,255,0.03);
  --line: rgba(255,255,255,0.05);
}

html[data-theme="Neon"] {
  --surface: rgba(255,0,127,0.08);
  --line: rgba(0,243,255,0.15);
}

*{box-sizing:border-box}html{background:var(--bg);color-scheme:dark}body{margin:0;min-height:100vh;background:radial-gradient(circle at 10% 0%,rgba(155,140,255,.10),transparent 32%),radial-gradient(circle at 90% 100%,rgba(98,215,255,.07),transparent 28%),var(--bg);color:var(--text);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow-x:hidden}button,input,select,textarea{font:inherit}button{border:0;color:inherit;cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent2);outline-offset:2px}body.reduced-motion *{animation:none!important;transition:none!important}.ambient{position:fixed;pointer-events:none;filter:blur(90px);opacity:.25;z-index:-2;border-radius:50%}.ambient-a{width:460px;height:460px;left:-220px;top:-180px;background:var(--accent)}.ambient-b{width:520px;height:520px;right:-260px;bottom:-260px;background:var(--accent2)}.grain{position:fixed;inset:0;pointer-events:none;opacity:.025;background-image:radial-gradient(#fff 1px,transparent 1px);background-size:5px 5px;z-index:20}.app-shell{display:grid;grid-template-columns:var(--sidebar) minmax(0,1fr);min-height:100vh}.sidebar{position:fixed;z-index:30;inset:0 auto 0 0;width:var(--sidebar);display:flex;flex-direction:column;padding:18px 12px;background:rgba(8,9,14,.88);border-right:1px solid var(--line);backdrop-filter:blur(24px);overflow:hidden}.brand{height:42px;display:flex;align-items:center;gap:10px;padding:0 10px;margin-bottom:18px;font-family:Inter,ui-sans-serif,system-ui,sans-serif;font-weight:800;letter-spacing:-.04em;cursor:pointer}.brand-mark{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#07080d;font-weight:900;box-shadow:0 0 28px color-mix(in srgb,var(--accent) 35%,transparent)}.mobile-close{display:none;position:absolute;right:10px;top:16px}.nav-scroll{min-height:0;overflow-y:auto;overflow-x:hidden;padding:2px 0 12px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.15) transparent}.nav-scroll::-webkit-scrollbar{width:5px}.nav-scroll::-webkit-scrollbar-thumb{background:rgba(255,255,255,.14);border-radius:99px}.nav-label{padding:17px 10px 7px;font-size:10px;text-transform:uppercase;letter-spacing:.16em;color:#666b77;font-weight:700}.nav-link{width:100%;height:40px;display:flex;align-items:center;gap:11px;padding:0 10px;margin:2px 0;background:transparent;border-radius:12px;color:#aeb2bc;text-align:left;transition:.2s var(--ease);white-space:nowrap}.nav-link:hover{background:var(--surface);color:#fff}.nav-link.active{background:linear-gradient(90deg,rgba(155,140,255,.16),rgba(98,215,255,.04));color:#fff;box-shadow:inset 2px 0 var(--accent)}.nav-link .ico{width:19px;text-align:center;font-size:16px;color:#777c88}.nav-link.active .ico{color:var(--accent2)}.nav-link kbd{margin-left:auto;font-size:9px;color:#5f6470;background:rgba(255,255,255,.04);border:1px solid var(--line);padding:2px 5px;border-radius:5px}.nav-badge{margin-left:auto;font-size:8px;letter-spacing:.08em;padding:3px 5px;border-radius:5px;background:rgba(98,215,255,.10);color:var(--accent2)}.nav-count{margin-left:auto;min-width:20px;text-align:center;color:#6f7480;font-size:11px}.sidebar-bottom{margin-top:auto;padding-top:12px;border-top:1px solid var(--line)}.account-chip{width:100%;display:flex;align-items:center;gap:9px;padding:8px;background:transparent;border-radius:13px;text-align:left}.account-chip:hover{background:var(--surface)}.account-chip strong,.account-chip small{display:block}.account-chip strong{font-size:12px}.account-chip small{font-size:10px;color:var(--muted)}.account-chip b{margin-left:auto;color:#6d7280}.avatar{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#08090e;font-weight:800}.main{grid-column:2;min-width:0;padding-bottom:calc(var(--player) + 30px)}.topbar{height:var(--top);display:flex;align-items:center;gap:14px;padding:0 30px;position:sticky;top:0;z-index:20;background:rgba(7,8,13,.72);backdrop-filter:blur(22px);border-bottom:1px solid rgba(255,255,255,.06)}.mobile-menu{display:none}.search-wrap{position:relative;flex:1;max-width:720px}.search-icon{position:absolute;left:13px;top:8px;color:#777d89;font-size:22px}.search-wrap input{width:100%;height:40px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.04);color:#fff;padding:0 70px 0 39px}.search-wrap input:focus{border-color:rgba(155,140,255,.45);background:rgba(255,255,255,.06)}.search-shortcut{position:absolute;right:10px;top:10px;font-size:9px;color:#696f7b;border:1px solid var(--line);padding:2px 5px;border-radius:5px}.search-dropdown{position:absolute;top:46px;left:0;right:0;display:none;padding:8px;background:#10121b;border:1px solid var(--line);border-radius:15px;box-shadow:0 25px 80px rgba(0,0,0,.55);max-height:440px;overflow:auto}.search-dropdown.open{display:block}.search-result{display:flex;align-items:center;gap:10px;padding:9px;border-radius:10px}.search-result:hover{background:var(--surface)}.search-result .thumb{width:38px;height:38px;border-radius:8px}.search-result small{display:block;color:var(--muted)}.top-actions{margin-left:auto;display:flex;gap:7px}.icon-btn{width:36px;height:36px;display:grid;place-items:center;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:10px;font-size:15px}.icon-btn:hover{background:var(--surface2)}.notification{position:relative}.notification span{position:absolute;right:8px;top:7px;width:5px;height:5px;border-radius:50%;background:var(--accent2)}.views{max-width:1600px;margin:auto;padding:0 30px}.view{display:none;padding:30px 0 70px;animation:viewIn .35s var(--ease)}.view.active{display:block}@keyframes viewIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}.hero{min-height:510px;display:grid;grid-template-columns:1.05fr .95fr;gap:34px;align-items:center;padding:42px 0 35px}.eyebrow,.section-kicker{font-size:10px;letter-spacing:.17em;text-transform:uppercase;color:#777d89;font-weight:800}.eyebrow{display:flex;align-items:center;gap:8px;color:#9ca1ad}.eyebrow i{width:6px;height:6px;border-radius:50%;background:var(--accent2);box-shadow:0 0 16px var(--accent2)}.hero h1{font:800 clamp(44px,6vw,82px)/.92 Inter,ui-sans-serif,system-ui,sans-serif;letter-spacing:-.075em;margin:16px 0 20px;max-width:800px}.hero h1 em{font-style:normal;color:transparent;background:linear-gradient(90deg,#fff 5%,var(--accent2) 65%,var(--accent));background-clip:text}.hero p{max-width:650px;color:#a8acb6;font-size:16px;line-height:1.75}.hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.btn{min-height:40px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 16px;border-radius:11px;font-weight:700;border:1px solid var(--line);transition:.2s var(--ease)}.btn.primary{background:linear-gradient(135deg,var(--accent),#7d6eff);color:#08090e;box-shadow:0 12px 30px rgba(155,140,255,.20)}.btn.primary:hover{transform:translateY(-1px);filter:brightness(1.08)}.btn.secondary{background:rgba(255,255,255,.055);color:#eef0f5}.btn.secondary:hover{background:rgba(255,255,255,.09)}.btn.small{min-height:35px;padding:0 12px;font-size:12px}.btn.full{width:100%}.hero-note{margin-top:18px;color:#707581;font-size:10px}.hero-note span{color:#8d93a0;font-weight:800;letter-spacing:.12em;margin-right:8px}.hero-stage{height:420px;position:relative;display:grid;place-items:center}.hero-poster{position:absolute;width:220px;height:300px;border-radius:24px;border:1px solid rgba(255,255,255,.16);box-shadow:0 35px 80px rgba(0,0,0,.45);overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;padding:20px;transform-origin:center;transition:.6s var(--ease)}.hero-poster:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 25%,rgba(0,0,0,.62));pointer-events:none}.hero-poster span,.hero-poster b{position:relative;z-index:1}.hero-poster span{font:800 28px/1 Manrope}.hero-poster b{font:700 11px;letter-spacing:.16em}.poster-a{background:linear-gradient(145deg,#9b8cff,#25204b 60%,#08090d);transform:rotate(-9deg) translate(-80px,12px)}.poster-b{background:linear-gradient(145deg,#62d7ff,#172b48 58%,#0b0d13);transform:rotate(2deg) translate(10px,-18px);z-index:2}.poster-c{background:linear-gradient(145deg,#ff8fbd,#30213f 60%,#0a0b10);transform:rotate(11deg) translate(86px,22px)}.hero-stage:hover .poster-a{transform:rotate(-13deg) translate(-94px,4px)}.hero-stage:hover .poster-b{transform:rotate(0) translate(0,-26px)}.hero-stage:hover .poster-c{transform:rotate(15deg) translate(100px,12px)}.hero-orbit{position:absolute;width:390px;height:390px;border:1px solid rgba(255,255,255,.07);border-radius:50%;box-shadow:0 0 100px rgba(98,215,255,.08) inset}.hero-badge{position:absolute;right:3%;bottom:3%;z-index:4;padding:13px 15px;border:1px solid var(--line);border-radius:14px;background:rgba(10,11,17,.76);backdrop-filter:blur(18px);box-shadow:0 20px 50px rgba(0,0,0,.3);min-width:180px}.hero-badge small,.hero-badge strong,.hero-badge span{display:block}.hero-badge small{font-size:8px;letter-spacing:.16em;color:#747986}.hero-badge strong{font:700 18px Manrope;margin:2px 0}.hero-badge span{font-size:10px;color:#858a96}.section{margin-top:42px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:15px;margin-bottom:15px}.section-head h2{font:700 24px/1.1 Manrope;margin:4px 0 0;letter-spacing:-.04em}.text-btn{background:transparent;color:#9da2ad;font-size:11px;padding:5px}.text-btn:hover{color:#fff}.media-row{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(190px,220px);gap:12px;overflow-x:auto;overflow-y:hidden;padding:2px 3px 12px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.12) transparent}.media-row::-webkit-scrollbar{height:5px}.media-row::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:99px}.media-card{min-width:0;position:relative}.thumb{position:relative;aspect-ratio:1;border-radius:17px;overflow:hidden;background:linear-gradient(135deg,#191c29,#0b0d13);border:1px solid var(--line);display:flex;align-items:flex-end;padding:13px;isolation:isolate}.thumb:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 25% 20%,rgba(255,255,255,.28),transparent 30%),linear-gradient(145deg,var(--tone,#7f74ff),#0b0c12 70%);z-index:-1}.thumb.video{aspect-ratio:16/10}.thumb .thumb-mark{font:800 38px Manrope;opacity:.88}.thumb .duration{position:absolute;right:8px;bottom:8px;padding:3px 6px;border-radius:5px;background:rgba(0,0,0,.65);font-size:9px}.thumb .play-float{position:absolute;left:12px;bottom:12px;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#fff;color:#08090d;opacity:0;transform:translateY(5px);transition:.2s var(--ease)}.media-card:hover .play-float{opacity:1;transform:none}.media-card:hover .thumb{border-color:rgba(155,140,255,.35);transform:translateY(-2px)}.card-meta{padding:8px 3px}.card-meta strong,.card-meta small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-meta strong{font-size:12px}.card-meta small{font-size:10px;color:#7f8490;margin-top:2px}.card-actions{position:absolute;top:8px;right:8px;display:flex;gap:5px;opacity:0;transform:translateY(-4px);transition:.2s}.media-card:hover .card-actions{opacity:1;transform:none}.mini-icon{width:29px;height:29px;border-radius:8px;background:rgba(5,6,10,.75);border:1px solid rgba(255,255,255,.12);color:#fff}.mini-icon:hover{background:#fff;color:#08090d}.experience-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.experience-card{min-height:240px;text-align:left;border:1px solid var(--line);border-radius:22px;padding:22px;background:var(--panel);position:relative;overflow:hidden;transition:.25s var(--ease)}.experience-card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,.18)}.experience-card:after{content:"";position:absolute;width:190px;height:190px;border-radius:50%;right:-70px;top:-80px;background:radial-gradient(circle,var(--tone),transparent 68%);opacity:.3}.experience-card strong{display:block;font:700 25px Manrope;margin:40px 0 10px}.experience-card p{max-width:340px;color:#9297a3;font-size:12px}.experience-number{color:#6c7280;font-size:10px;letter-spacing:.15em}.experience-link{position:absolute;bottom:20px;color:#c4c7cf;font-size:11px}.experience-discover{--tone:var(--accent)}.experience-watch{--tone:var(--accent2)}.experience-listen{--tone:#ff8db9}.format-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.format-card{min-height:150px;padding:18px;border:1px solid var(--line);border-radius:18px;background:var(--surface);text-align:left;position:relative;overflow:hidden}.format-card:hover{background:var(--surface2);transform:translateY(-2px)}.format-card span{font-size:24px;color:var(--accent2)}.format-card strong,.format-card small{display:block}.format-card strong{font:700 17px Manrope;margin-top:18px}.format-card small{color:#777d88;font-size:10px}.page-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:10px 0 28px}.page-heading h1{font:800 clamp(38px,5vw,62px)/.95 Manrope;margin:5px 0 9px;letter-spacing:-.065em}.page-heading p{margin:0;max-width:760px;color:#969ba7;line-height:1.65}.pill{display:inline-flex;align-items:center;min-height:22px;padding:4px 8px;border-radius:6px;background:rgba(155,140,255,.10);color:#c4baff;border:1px solid rgba(155,140,255,.16);font-size:8px;letter-spacing:.14em;font-weight:800}.music-spotlight,.discover-hero{border:1px solid var(--line);border-radius:24px;background:linear-gradient(110deg,rgba(155,140,255,.12),rgba(98,215,255,.04) 45%,rgba(255,255,255,.03));padding:25px;display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:150px}.music-spotlight h2,.discover-hero h2{font:700 28px Manrope;letter-spacing:-.04em;margin:7px 0}.music-spotlight p,.discover-hero p{color:#9297a3;max-width:650px;margin:0}.music-stat{text-align:right}.music-stat strong{display:block;font:800 42px Manrope}.music-stat small{color:#777d88}.filter-pills{display:flex;flex-wrap:wrap;gap:7px;margin:18px 0}.filter-pills.compact{margin:0;justify-content:flex-end}.filter{padding:7px 11px;border:1px solid var(--line);background:var(--surface);border-radius:99px;color:#8f94a0;font-size:10px}.filter.active,.filter:hover{background:rgba(155,140,255,.14);color:#fff;border-color:rgba(155,140,255,.3)}.sort-row select,.setting-item select,.select-label select{height:34px;padding:0 10px;border-radius:9px;background:#11131c;border:1px solid var(--line);color:#dfe2e8}.explore-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:18px 12px}.discover-hero{min-height:260px;overflow:hidden}.discover-art{width:300px;align-self:stretch;border-radius:17px;background:radial-gradient(circle at 25% 25%,#fff,transparent 3%),conic-gradient(from 180deg,var(--accent),#13102c,var(--accent2),#090a10,var(--accent));display:grid;place-items:center;position:relative}.discover-art span{font:800 60px Manrope;letter-spacing:-.08em}.mood-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:9px}.mood-card{min-height:100px;border-radius:15px;border:1px solid var(--line);padding:13px;background:linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.02));text-align:left;position:relative;overflow:hidden}.mood-card:after{content:"";position:absolute;width:100px;height:100px;right:-40px;bottom:-45px;border-radius:50%;background:var(--tone);filter:blur(10px);opacity:.28}.mood-card strong{display:block;font:700 14px Manrope}.mood-card small{display:block;color:#747a86;font-size:9px;margin-top:4px}.watch-hero{display:grid;grid-template-columns:1.1fr .9fr;min-height:390px;border-radius:25px;border:1px solid var(--line);overflow:hidden;background:#090a0f;margin-bottom:38px}.watch-hero-art{min-height:390px;position